# =============================================================================
# RoadVision — AI-POWERED CITIZEN ROAD DAMAGE REPORTING AND GOVERNMENT RESPONSE
# Environment template. Copy to `.env` (root) and adjust.
# NEVER commit a real .env file or real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# General / browser origin
# -----------------------------------------------------------------------------
NODE_ENV=development
# Allowed frontend origin(s), comma-separated. Used for credentialed CORS.
# Production camera + Geolocation APIs REQUIRE HTTPS (localhost is the dev exception).
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Backend (Node.js / Express)
# -----------------------------------------------------------------------------
PORT=5000
DATABASE_URL=mongodb://localhost:27017/rdd
# "mongo" = real MongoDB; "demo" = explicitly labelled in-memory demo store.
DATA_MODE=mongo
DEMO_SEED=false
# Legacy citizen/account tooling only. NOT required for public reporting.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# Separate HMAC key for public report IDs, citizen capability hashes and IP hashes.
# Production requires this to be distinct from both JWT keys.
HMAC_SECRET=change-me-to-a-third-long-random-secret
# Separate official session signing key. Use a distinct 32+ byte random secret.
OFFICIAL_JWT_SECRET=change-me-to-a-different-long-random-secret
OFFICIAL_JWT_EXPIRES_IN=8h
# Production defaults to true and requires HTTPS. Set false ONLY for local HTTP Compose.
OFFICIAL_COOKIE_SECURE=false
OFFICIAL_LOGIN_MAX_FAILURES=5
OFFICIAL_LOCKOUT_MINUTES=15

# AI micro-service
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=60000
MODEL_CONFIDENCE_THRESHOLD=0.35

# Image storage abstraction (local dev adapter; no public directory listing)
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
PUBLIC_REPORT_WINDOW_MINUTES=60
PUBLIC_REPORT_MAX_REQUESTS=8
PUBLIC_REPORT_IDENTICAL_LIMIT=3
PUBLIC_REPORT_DAILY_IP_LIMIT=20
PUBLIC_REPORT_ABUSE_WINDOW_MINUTES=60

# Browser location validation
MAX_LOCATION_ACCURACY_METERS=10000
MAX_LOCATION_AGE_MINUTES=30
MAX_LOCATION_FUTURE_MINUTES=5

# Duplicate / incident grouping (operational heuristics, configurable)
DUPLICATE_RADIUS_METERS=75
DUPLICATE_WINDOW_MINUTES=1440

# Configurable planning SLAs in hours. These are NOT statutory government SLAs.
SLA_RULES_JSON={"LOW":168,"MEDIUM":96,"HIGH":48,"CRITICAL":24}

# Controlled first official bootstrap; alternatively use
# `cd backend && npm run provision:official` with DATA_MODE=mongo.
# There is deliberately NO public official self-registration endpoint.
# OFFICIAL_BOOTSTRAP_EMAIL=admin@agency.example
# OFFICIAL_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# OFFICIAL_BOOTSTRAP_NAME=System Administrator
# OFFICIAL_BOOTSTRAP_DESIGNATION=System Administrator
# OFFICIAL_BOOTSTRAP_DEPARTMENT=Operations

# Optional legacy admin email allowlist
ADMIN_EMAILS=

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Dev/test only; never true in production.
EXPOSE_RESET_TOKENS=false

# -----------------------------------------------------------------------------
# AI Service (Python / FastAPI)
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
# "auto" uses real weights when available, otherwise a clearly labelled DEMO MODE.
AI_MODE=auto
MODEL_PATH=ai-service/models/road_damage_yolo.pt
MODEL_IOU_THRESHOLD=0.45
MODEL_DEVICE=auto
AI_MAX_IMAGE_MB=16
