# =============================================================================
# AI Road Damage Detection — environment template
# Copy to `.env` (root) and adjust. NEVER commit a real .env file.
# Each service reads what it needs; see docs/DEPLOYMENT.md for per-service envs.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
# Origin of the frontend, used for CORS and password-reset links
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Backend (Node.js / Express) — backend/.env or process env
# -----------------------------------------------------------------------------
PORT=5000
# MongoDB connection string (production data store)
DATABASE_URL=mongodb://localhost:27017/rdd
# Data layer: "mongo" (default, production) | "demo" (explicitly-labelled
# in-memory demo store for environments without MongoDB — UI shows DEMO MODE)
DATA_MODE=mongo
# Seed sample inspections when DATA_MODE=demo (always labelled as demo data)
DEMO_SEED=false
# Auth token settings — use a long random secret in production (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
# AI micro-service URL used by the backend
AI_SERVICE_URL=http://localhost:8000
# Where uploaded images are stored (kept outside of application source)
UPLOAD_DIRECTORY=uploads
# Upload validation
MAX_UPLOAD_MB=10
# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# AI Service (Python / FastAPI) — ai-service/.env or process env
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
# "auto" (real model if available, otherwise clearly-labelled demo engine),
# "real" (fail fast when the model is unavailable) | "demo" (force demo engine)
AI_MODE=auto
# Path to trained YOLO road-damage weights (see docs/AI_MODEL.md)
MODEL_PATH=ai-service/models/road_damage_yolo.pt
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.45
# "auto" | "cpu" | "cuda"
MODEL_DEVICE=auto
AI_MAX_IMAGE_MB=16
